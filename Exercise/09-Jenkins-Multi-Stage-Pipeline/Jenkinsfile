pipeline {
    agent any

    environment {
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                sh '''
                python3 -m pip install -r requirements.txt || true
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running automated tests...'
                sh 'python3 -m unittest discover -s .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application to local target directory...'
                sh '''
                mkdir -p ${DEPLOY_DIR}
                cp ${WORKSPACE}/app.py ${DEPLOY_DIR}/
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting application background daemon...'
                sh '''
                nohup python3 ${DEPLOY_DIR}/app.py > ${DEPLOY_DIR}/app.log 2>&1 &
                echo $! > ${DEPLOY_DIR}/app.pid
                sleep 2
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing deployed application...'
                sh '''
                python3 ${WORKSPACE}/test_app.py
                '''
            }
        }
    }

    post {
        always {
            echo 'Cleaning up application process...'
            sh '''
            if [ -f ${DEPLOY_DIR}/app.pid ]; then
                kill $(cat ${DEPLOY_DIR}/app.pid) 2>/dev/null || true
                rm -f ${DEPLOY_DIR}/app.pid
            fi
            '''
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
